rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Trận đấu và phiên chơi: Cho phép học sinh và giáo viên đọc ghi trực tiếp không cần đăng nhập Gmail
    match /game_sessions/{sessionId} {
      allow read, write: if true;

      match /students/{studentId} {
        allow read, write: if true;
      }
    }

    // Danh sách học sinh tham gia và tiến trình gõ phím
    match /students/{studentId} {
      allow read, write: if true;
    }

    // Lịch sử kết quả trận đấu để giáo viên tra cứu
    match /match_history/{historyId} {
      allow read, write: if true;
    }
  }
}
